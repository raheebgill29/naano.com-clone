# Supabase (Naana assignment project)
# Copy to .env.local and fill in values from the Supabase project settings.
# Never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the publishable key; legacy anon JWT key also works for local SSR setups.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional fallback if you only have the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Do not put the service-role key in this app. Seed scripts / admin tasks
# should use a separate, non-committed environment if needed.
